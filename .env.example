# Copy to .env. Every value here is a safe dummy for local use; never commit real secrets (spec section 10).
ENV=dev
DB_OWNER_PASSWORD=change-me-owner
APP_DB_PASSWORD=change-me-app
APP_ORIGIN=http://localhost:8080
# 32+ random characters in production
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789
# 32-byte keys, base64 (python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())")
PHONE_ENC_KEY=ZGV2LW9ubHktcGhvbmUtZW5jLWtleS0zMmJ5dGVzISE=
PHONE_HASH_KEY=ZGV2LW9ubHktcGhvbmUtaGFzaC1rZXktMzJieXRlcyE=
TOTP_ENC_KEY=ZGV2LW9ubHktdG90cC1zZWNyZXQta2V5LTMyYnl0ZSE=
ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=7
# false only for plain-http local dev without the nginx front end
COOKIE_SECURE=true
CELERY_ALWAYS_EAGER=false
SMS_PROVIDER=mock
LOG_LEVEL=INFO
# demo seed (synthetic accounts)
DEMO_PASSWORD=synthetic-demo-pass
DEMO_TOTP_SECRET=LIFEGRIDDEMOSECRETKEYAAAAAAAAAAA
